# Token von @BotFather
BOT_TOKEN=123456:ABC-DEF

# Deine Telegram-ID(s), kommagetrennt. Owner haben in allen Gruppen und im Web-Panel vollen Zugriff.
OWNER_IDS=

# Optional: Chat-ID für Mod-Logs (Gruppe/Kanal, Bot muss dort schreiben dürfen)
LOG_CHAT_ID=

# ---- Web-Dashboard (optional) ----
# Owner-Passwort für das Web-Panel. Leer = kein Passwort-Login.
WEB_PASSWORD=
# Anmeldung per Telegram (jeder Gruppen-Admin sieht nur seine eigenen Gruppen):
# leer/on = an (sobald das Dashboard läuft), off = aus. "on" startet das Dashboard auch ohne Passwort.
WEB_TELEGRAM=
# 127.0.0.1 = nur auf diesem Handy erreichbar (empfohlen); 0.0.0.0 = im WLAN erreichbar
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Nur bei HTTPS-Reverse-Proxy: 1 = Cookie mit "Secure", Client-IP aus X-Forwarded-For
WEB_SECURE=
WEB_TRUST_PROXY=
